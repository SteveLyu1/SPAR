{
  "project_name": "dar_hate_phase1",
  "seed": 20260403,
  "paths": {
    "input_jsonl": "DAR/outputs/phase0/cleaned_zh_train.jsonl",
    "output_root": "DAR/outputs/phase1",
    "runs_root": "DAR/outputs/phase1/runs",
    "model_root": "/usr/2Tusr/llm",
    "segmenter_model_path": "/usr/2Tusr/llm/Qwen3-14B",
    "segmenter_prompt_path": "DAR/prompts/phase1_segmenter_prompt_v2_lang_source_fewshot.txt",
