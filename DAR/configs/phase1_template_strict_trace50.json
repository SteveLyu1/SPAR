    "max_batch_size": 6,
    "auto_batch_shrink": true,
    "auto_batch_grow": true,
    "batch_grow_interval": 3,
    "temperature": 0.2,
    "top_p": 0.9,
    "top_k": 20,
    "repetition_penalty": 1.0,
    "enable_thinking": false,
    "dtype": "float16",
    "device_map": "balanced",
    "require_cuda": true,
    "prefer_4090_order": true,
    "force_4090_order": false,
    "preferred_gpu_mem_ratio": 0.97,
