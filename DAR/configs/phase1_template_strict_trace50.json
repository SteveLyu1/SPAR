    "segmenter_prompt_path_en": "DAR/prompts/phase1_segmenter_prompt_en_fewshot.txt"
  },
  "segmenter": {
    "mode": "qwen_local",
    "prompt_version": "phase1_segmenter_v3_bilingual_trainfewshot",
