        "filter_mode": "all",
        "supervision_target": "teacher"
      },
      {
        "name": "stage1_clean",
        "description": "High-precision stage using language-specific external selector exact agreement with ground truth.",
        "filter_mode": "external_selector_clean",
        "supervision_target": "ground_truth_primary"
      },
      {
        "name": "stage2_silver",
        "description": "Expanded stage using language-specific external selector silver agreement with ground truth.",
        "filter_mode": "external_selector_silver",
        "supervision_target": "ground_truth_primary"
      },
      {
        "name": "stage2_bridge_hq",
        "description": "Expanded high-quality stage: selector silver plus language-aware teacher-to-ground-truth bridge rows with controlled conflict and no severe structural errors.",
        "filter_mode": "selector_silver_teacher_bridge",
        "supervision_target": "ground_truth_primary",
        "bridge_require_same_label": true,
        "bridge_require_any_teacher_fields": [
