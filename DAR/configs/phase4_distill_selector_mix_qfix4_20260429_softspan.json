        "bridge_max_conflict_score": 0.67,
        "bridge_max_conflict_by_language": {
          "zh": 0.85,
          "en": 0.67
        },
        "bridge_exclude_error_tags": [
          "auditor_rejected",
          "defective_role",
          "missing_roles"
        ]
      }
    ]
